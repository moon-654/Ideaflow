{
    "apps": [
        {
            "name": "ideaflow-api",
            "script": "dist/index.js",
            "cwd": "./server",
            "instances": 1,
            "exec_mode": "fork",
            "watch": false,
            "env": {
                "NODE_ENV": "production",
                "PORT": 4000
            },
            "env_file": ".env",
            "log_date_format": "YYYY-MM-DD HH:mm:ss",
            "error_file": "logs/error.log",
            "out_file": "logs/out.log",
            "merge_logs": true,
            "max_restarts": 10,
            "restart_delay": 1000
        }
    ]
}